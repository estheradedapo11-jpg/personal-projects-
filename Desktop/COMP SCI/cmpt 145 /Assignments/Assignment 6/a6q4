class treenode:
    def __init__(self, data, left=None, right=None):
        """
        Purpose:
            Initialize a new treenode with the given data and optional left and right children.
        Pre-conditions:
            data: The data value to be stored in the node (any type).
            left: A reference to the left child (another treenode or None).
            right: A reference to the right child (another treenode or None).
        Post-conditions:
            A new treenode is created with the specified data, left child, and right child.
        Returns:
            None
        """
        self.data = data
        self.left = left
        self.right = right


def expression(t):
    """
    Purpose:
        Convert an expression tree into its corresponding mathematical formula string.
    Pre-conditions:
        t: A treenode representing the root of an expression tree.
    Post-conditions:
        The tree is traversed to build the mathematical formula string.
    Returns:
        A string representing the mathematical formula, with each operator surrounded by brackets.
        If the tree is empty, returns an empty string.
    """
    if t is None:
        return ""
    if t.left is None and t.right is None:
        return str(t.data)
    left_expr = expression(t.left)
    right_expr = expression(t.right)
    return f"({left_expr} {t.data} {right_expr})"
