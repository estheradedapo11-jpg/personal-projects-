import exampletrees
from a6q2 import replace, mirror_copy, collect_data_preorder, count_larger

def test_replace():
    """
    Purpose:
        Test cases for the replace() function.
    """
    # Test 1: Empty tree
    tree = None
    replace(tree, 1, 2)
    assert tree is None, "Test 1 Failed"

    # Test 2: Tree with one node, target present
    tree = exampletrees.one_node_tree()
    replace(tree, 10, 20)
    assert tree.data == 20, "Test 2 Failed"

    # Test 3: Tree with one node, target not present
    tree = exampletrees.one_node_tree()
    replace(tree, 5, 20)
    assert tree.data == 10, "Test 3 Failed"

    # Test 4: Tree with multiple nodes, target present
    tree = exampletrees.three_node_tree()
    replace(tree, 20, 99)
    assert tree.left.data == 99, "Test 4 Failed"

    print("All replace() tests passed.")

def test_mirror_copy():
    """
    Purpose:
        Test cases for the mirror_copy() function.
    """
    # Test 1: Empty tree
    tree = None
    mirrored = mirror_copy(tree)
    assert mirrored is None, "Test 1 Failed"

    # Test 2: Tree with one node
    tree = exampletrees.one_node_tree()
    mirrored = mirror_copy(tree)
    assert mirrored.data == tree.data, "Test 2 Failed"

    # Test 3: Tree with multiple nodes
    tree = exampletrees.three_node_tree()
    mirrored = mirror_copy(tree)
    assert mirrored.left.data == tree.right.data, "Test 3 Failed"
    assert mirrored.right.data == tree.left.data, "Test 3 Failed"

    print("All mirror_copy() tests passed.")

def test_collect_data_preorder():
    """
    Purpose:
        Test cases for the collect_data_preorder() function.
    """
    # Test 1: Empty tree
    tree = None
    result = collect_data_preorder(tree)
    assert result == [], "Test 1 Failed"

    # Test 2: Tree with one node
    tree = exampletrees.one_node_tree()
    result = collect_data_preorder(tree)
    assert result == [10], "Test 2 Failed"

    # Test 3: Tree with multiple nodes
    tree = exampletrees.three_node_tree()
    result = collect_data_preorder(tree)
    assert result == [10, 20, 30], "Test 3 Failed"

    print("All collect_data_preorder() tests passed.")

def test_count_larger():
    """
    Purpose:
        Test cases for the count_larger() function.
    """
    # Test 1: Empty tree
    tree = None
    result = count_larger(tree, 10)
    assert result == 0, "Test 1 Failed"

    # Test 2: Tree with one node, count greater
    tree = exampletrees.one_node_tree()
    result = count_larger(tree, 5)
    assert result == 1, "Test 2 Failed"

    # Test 3: Tree with multiple nodes, count greater
    tree = exampletrees.three_node_tree()
    result = count_larger(tree, 15)
    assert result == 2, "Test 3 Failed"

    print("All count_larger() tests passed.")

if __name__ == "__main__":
    test_replace()
    test_mirror_copy()
    test_collect_data_preorder()
    test_count_larger()
    print("All tests passed.")
