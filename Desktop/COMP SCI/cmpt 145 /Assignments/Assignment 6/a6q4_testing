from a6q4 import treenode, expression

def test_expression():
    """
    Purpose:
        Test cases for the expression() function.
    """
    # Test 1: Empty tree
    assert expression(None) == "", "Test 1 Failed"

    # Test 2: Tree with one node
    t1 = treenode(42)
    assert expression(t1) == "42", "Test 2 Failed"

    # Test 3: Tree with multiple nodes (balanced)
    t2 = treenode('+', treenode(3), treenode(5))
    assert expression(t2) == "(3 + 5)", "Test 3 Failed"

    # Test 4: Tree with multiple nodes (unbalanced)
    t3 = treenode('*', t2, treenode('-', treenode(10), treenode(2)))
    assert expression(t3) == "((3 + 5) * (10 - 2))", "Test 4 Failed"

    # Test 5: Tree with deeper levels
    t4 = treenode('-', t3, treenode(8))
    assert expression(t4) == "(((3 + 5) * (10 - 2)) - 8)", "Test 5 Failed"

    print("All expression() tests passed.")

if __name__ == "__main__":
    test_expression()
    print("All tests passed.")
